---
import '../styles/global.css';
import { languages, ogLocale, otherLang, path, type Lang, type PageKey } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  lang?: Lang;
  /** Pagina-sleutel; bepaalt canonical, hreflang-alternatieven en de taalwissel. */
  page?: PageKey;
}

const {
  title,
  description,
  image = '/og-default.jpg',
  canonical,
  noindex = false,
  lang = 'nl',
  page,
} = Astro.props;

const t = ui[lang];
const siteUrl = Astro.site ?? new URL('https://www.fotograafpromotiesradboud.nl');
const canonicalUrl = new URL(canonical ?? (page ? path(page, lang) : Astro.url.pathname), siteUrl).href;
const ogImage = new URL(image, siteUrl).href;
const currentYear = new Date().getFullYear();
const mainSiteUrl = 'https://paulbreuker.nl/';

const alternates = page
  ? languages.map((l) => ({ lang: l, href: new URL(path(page, l), siteUrl).href }))
  : [];
const switchLang = otherLang(lang);
// Taalschakelaar: huidige taal gevuld, andere taal als link naar dezelfde pagina.
const langOptions = languages.map((l) => ({
  lang: l,
  label: l.toUpperCase(),
  name: t.langSwitch.names[l],
  href: path(page ?? 'home', l),
  current: l === lang,
}));

const professionalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: t.schema.name,
  description: t.schema.description,
  url: siteUrl.origin,
  image: [ogImage],
  serviceType: 'Promotion photography',
  areaServed: {
    '@type': 'City',
    name: 'Nijmegen',
  },
  provider: {
    '@type': 'Person',
    name: 'Paul Breuker',
    jobTitle: t.schema.jobTitle,
    url: mainSiteUrl,
    email: 'info@paulbreuker.nl',
    telephone: '+31651475406',
  },
  offers: {
    '@type': 'Offer',
    price: '270',
    priceCurrency: 'EUR',
    description: t.schema.offer,
  },
  sameAs: [mainSiteUrl],
};

const navItems = [
  { href: path('pricing', lang), label: t.nav.pricing },
  { href: path('about', lang), label: t.nav.about },
  { href: path('contact', lang), label: t.nav.contact },
];
const contactHref = path('contact', lang);

// Bepaal welk navigatie-item de huidige pagina is, voor de actieve-state indicator.
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const normalized = href.replace(/\/$/, '') || '/';
  return currentPath === normalized;
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Basis meta -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Taalversies -->
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
    {page && <link rel="alternate" hreflang="x-default" href={new URL(path(page, 'nl'), siteUrl).href} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {page && <meta property="og:locale:alternate" content={ogLocale[switchLang]} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts en site assets -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(professionalServiceSchema)}
    />
    <slot name="schema" />
  </head>
  <body class="min-h-screen bg-cream font-sans text-ink antialiased">
    <!-- Header -->
    <slot name="header">
      <header class="sticky top-0 z-50 border-b border-ink bg-cream">
        <div class="mx-auto flex h-20 max-w-[1440px] items-center justify-between px-6 md:px-16">
          <a href={path('home', lang)} class="flex items-center gap-3 font-mono text-[13px] uppercase tracking-[0.06em]">
            <span class="grid h-9 w-9 grid-cols-2 gap-1" aria-hidden="true">
              <span class="border border-ink"></span>
              <span class="border border-ink"></span>
              <span class="border border-ink"></span>
              <span class="bg-ink"></span>
            </span>
            <span>Paul Breuker</span>
          </a>

          <div class="flex items-center gap-3 md:gap-7">
          <!-- Desktop navigatie -->
          <nav class="hidden items-center gap-7 font-mono text-[13px] uppercase tracking-[0.04em] md:flex" aria-label={t.nav.ariaMain}>
            {
              navItems.map((item) => {
                const active = isActive(item.href);
                return (
                  <a
                    class:list={[
                      'transition hover:opacity-60',
                      active &&
                        'border-b-2 border-accent-red pb-[2px] -mb-[2px]',
                    ]}
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                );
              })
            }
            <a
              class="rounded-[10px] bg-ink px-6 py-3 text-cream transition-colors duration-200 hover:bg-accent-red-dark"
              href={contactHref}
            >
              {t.cta}
            </a>
          </nav>

          <!-- Taalschakelaar (desktop en mobiel) -->
            <div
              role="group"
              aria-label={t.langSwitch.group}
              class="flex h-11 items-center rounded-full border border-ink p-1 font-mono text-[12px] tracking-[0.06em]"
            >
              {
                langOptions.map((option) =>
                  option.current ? (
                    <span
                      aria-current="true"
                      title={option.name}
                      class="grid h-full place-items-center rounded-full bg-ink px-3 text-cream"
                    >
                      {option.label}
                    </span>
                  ) : (
                    <a
                      href={option.href}
                      hreflang={option.lang}
                      lang={option.lang}
                      aria-label={option.name}
                      title={option.name}
                      class="grid h-full place-items-center rounded-full px-3 transition-colors duration-200 hover:text-accent-red"
                    >
                      {option.label}
                    </a>
                  ),
                )
              }
            </div>

          <!-- Mobile menu trigger -->
          <button
            type="button"
            id="mobile-menu-toggle"
            aria-label={t.menu.ariaOpen}
            data-label-open={t.menu.ariaOpen}
            data-label-close={t.menu.ariaClose}
            aria-controls="mobile-menu"
            aria-expanded="false"
            class="md:hidden w-11 h-11 border border-ink rounded-full flex items-center justify-center font-mono text-xs tracking-[0.04em] uppercase hover:bg-accent-red-dark hover:text-cream hover:border-accent-red-dark transition-colors duration-200"
          >
            <span class="menu-text-open">{t.menu.open}</span>
            <span class="menu-text-close hidden">{t.menu.close}</span>
          </button>
          </div>
        </div>
      </header>

      <!-- Mobile menu drawer -->
      <div
        id="mobile-menu"
        class="hidden md:hidden fixed inset-x-0 top-20 bottom-0 bg-cream z-40 overflow-y-auto"
        role="dialog"
        aria-modal="true"
        aria-label={t.nav.ariaMain}
      >
        <nav class="flex flex-col px-6 pt-8 pb-4">
          {
            navItems.map((item) => {
              const active = isActive(item.href);
              return (
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class="font-mono text-sm tracking-[0.04em] uppercase py-4 border-b border-ink/10 hover:opacity-60 transition flex items-center gap-3"
                >
                  {active && (
                    <span
                      class="inline-block h-1.5 w-1.5 rounded-full bg-accent-red"
                      aria-hidden="true"
                    />
                  )}
                  {item.label}
                </a>
              );
            })
          }
        </nav>

        <!-- Footer area in drawer -->
        <div class="px-6 py-6 border-t border-ink/10 mt-4">
          <a
            href={contactHref}
            class="block bg-ink text-cream font-mono text-xs tracking-[0.06em] uppercase px-6 py-4 rounded-[10px] text-center hover:bg-accent-red-dark transition-colors duration-200"
          >
            {t.cta}
          </a>
        </div>
      </div>
    </slot>

    <!-- Pagina-inhoud -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <slot name="footer">
      <footer class="border-t-2 border-accent-red bg-cream">
        <div class="mx-auto max-w-[1440px] px-6 py-16 md:px-16">
          <div class="grid gap-10 md:grid-cols-3 md:divide-x md:divide-ink">
            <section>
              <h3 class="text-2xl font-medium uppercase leading-none tracking-tight">
                {t.footer.title[0]}<br />{t.footer.title[1]}
              </h3>
              <p class="mt-6 max-w-xs text-[15px] leading-6">
                {t.footer.tagline}
              </p>
              <p class="mt-4 max-w-xs text-[15px] leading-6">
                {t.footer.portraitBefore}
                <a
                  class="underline underline-offset-4 transition hover:opacity-60"
                  href={mainSiteUrl}
                  target="_blank"
                  rel="noopener"
                >
                  paulbreuker.nl
                </a>.
              </p>
            </section>

            <section class="md:pl-10">
              <h3 class="font-mono text-[13px] uppercase tracking-[0.06em]">{t.footer.pages}</h3>
              <ul class="mt-5 space-y-3 font-mono text-[13px] uppercase tracking-[0.04em]">
                {
                  navItems.map((item) => (
                    <li>
                      <a class="transition hover:opacity-60" href={item.href}>
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </section>

            <section class="md:pl-10">
              <h3 class="font-mono text-[13px] uppercase tracking-[0.06em]">{t.footer.contact}</h3>
              <ul class="mt-5 space-y-3 text-[15px] leading-6">
                <li>
                  <a class="transition hover:opacity-60" href="mailto:info@paulbreuker.nl">
                    info@paulbreuker.nl
                  </a>
                </li>
                <li>
                  <a class="transition hover:opacity-60" href="tel:+31651475406">
                    +31 6 51 47 54 06
                  </a>
                </li>
              </ul>
            </section>

          </div>

          <div
            class="mt-16 border-t border-ink pt-6 font-mono text-[11px] uppercase tracking-[0.06em] md:grid md:grid-cols-2"
          >
            <p>&copy; {currentYear} {t.footer.copyright}</p>
            <p class="mt-2 md:mt-0 md:text-right">
              {t.footer.bottomLine}
              <a
                class="underline transition hover:opacity-60"
                href="https://neqst.nl/"
                target="_blank"
                rel="noopener"
              >
                Neqst
              </a>
            </p>
          </div>
        </div>
      </footer>
    </slot>
    <script is:inline>
      (function() {
        const toggle = document.getElementById('mobile-menu-toggle');
        const menu = document.getElementById('mobile-menu');
        if (!toggle || !menu) return;

        const openText = toggle.querySelector('.menu-text-open');
        const closeText = toggle.querySelector('.menu-text-close');

        function setMenu(open) {
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          toggle.setAttribute(
            'aria-label',
            open ? toggle.dataset.labelClose : toggle.dataset.labelOpen,
          );

          if (open) {
            menu.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            openText.classList.add('hidden');
            closeText.classList.remove('hidden');
          } else {
            menu.classList.add('hidden');
            document.body.style.overflow = '';
            openText.classList.remove('hidden');
            closeText.classList.add('hidden');
          }
        }

        toggle.addEventListener('click', function() {
          const isOpen = toggle.getAttribute('aria-expanded') === 'true';
          setMenu(!isOpen);
        });

        // Sluit menu bij klik op een link
        menu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => setMenu(false));
        });

        // Sluit op escape-toets
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setMenu(false);
          }
        });
      })();
    </script>
  </body>
</html>
