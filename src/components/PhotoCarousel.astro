---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Carousel from './Carousel.astro';
import type { Lang } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Photo {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  photos: Photo[];
  label: string;
  lang?: Lang;
}

const { photos, label, lang = 'nl' } = Astro.props;
const t = ui[lang].carousel;
---

<Carousel label={label} prevLabel={t.prevPhotos} nextLabel={t.nextPhotos} lang={lang}>
  {
    photos.map((photo, index) => (
      <li
        class="w-full shrink-0 snap-start md:w-[calc((100%-2rem)/2)]"
        aria-roledescription={t.slide}
        aria-label={`${index + 1} ${t.of} ${photos.length}`}
      >
        <Image
          src={photo.src}
          alt={photo.alt}
          class="aspect-[3/2] w-full rounded-2xl object-cover"
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 50vw"
          loading={index < 2 ? 'eager' : 'lazy'}
        />
      </li>
    ))
  }
</Carousel>
