---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../i18n/content/contact';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = contact[lang];

const inputClass =
  'w-full rounded-[10px] border border-ink bg-transparent px-4 py-4 text-ink transition focus:bg-ink focus:text-cream focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-red focus-visible:ring-offset-2 focus-visible:ring-offset-cream';
const labelClass = 'mb-2 block font-mono text-xs tracking-[0.04em] uppercase opacity-60';
---

<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang} page="contact">
  <!-- SECTIE 1: PAGE HEADER -->
  <section class="mx-auto max-w-[1440px] px-6 pt-24 pb-12 md:px-16 md:pt-32 md:pb-16">
    <div class="mx-auto max-w-3xl border-t border-ink pt-10 text-center">
      <p class="font-mono text-xs tracking-[0.04em] uppercase opacity-60">{t.header.eyebrow}</p>
      <h1 class="mt-6 text-5xl font-medium leading-none tracking-[-0.02em] md:text-7xl">
        {t.header.title}
      </h1>
      <p class="mt-8 text-[17px] leading-[1.55]">
        {t.header.intro}
      </p>
    </div>
  </section>

  <!-- SECTIE 2: FORMULIER + DIRECT CONTACT -->
  <section class="mx-auto max-w-[1440px] px-6 pb-24 md:px-16 md:pb-32">
    <div class="grid gap-12 border-t border-ink pt-10 md:grid-cols-3 md:gap-16">
      <div class="md:col-span-2">
        <div
          id="form-error"
          class="hidden mb-6 rounded-[10px] border border-accent-red px-4 py-4 text-sm leading-relaxed"
        >
          {t.form.errorBefore}
          <a href="mailto:info@paulbreuker.nl" class="underline transition hover:opacity-60">
            info@paulbreuker.nl
          </a>.
        </div>

        <!-- Veldnamen blijven Nederlands, zodat aanvragen uit beide talen er in de mailbox hetzelfde uitzien. -->
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-6"
          data-submitting={t.form.submitting}
        >
          <input type="hidden" name="access_key" value="98cd5d83-66f0-44b2-bc36-ef89e468e7fe" />
          <input type="hidden" name="subject" value={t.form.subject} />
          <input type="hidden" name="from_name" value="fotograafpromotiesradboud.nl" />
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
          />

          <div>
            <label for="naam" class={labelClass}>{t.form.name}</label>
            <input id="naam" name="naam" type="text" required class={inputClass} />
          </div>

          <div>
            <label for="email" class={labelClass}>{t.form.email}</label>
            <input id="email" name="email" type="email" autocomplete="email" required class={inputClass} />
          </div>

          <div>
            <label for="telefoon" class={labelClass}>{t.form.phone}</label>
            <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" required class={inputClass} />
          </div>

          <div>
            <label for="datum_promotie" class={labelClass}>{t.form.date}</label>
            <input id="datum_promotie" name="datum_promotie" type="date" required class={inputClass} />
          </div>

          <div>
            <label for="tijdstip" class={labelClass}>{t.form.time}</label>
            <input id="tijdstip" name="tijdstip" type="time" required class={inputClass} />
          </div>

          <div>
            <label for="bericht" class={labelClass}>
              {t.form.message} <span class="normal-case tracking-normal">{t.form.optional}</span>
            </label>
            <textarea
              id="bericht"
              name="bericht"
              rows="5"
              placeholder={t.form.placeholder}
              class={`${inputClass} placeholder:text-ink/60`}
            ></textarea>
          </div>

          <!-- Spambeveiliging: hCaptcha via Web3Forms (gratis plan). Web3Forms controleert de token server-side. -->
          <div>
            <div class="h-captcha" data-captcha="true" data-lang={lang}></div>
            <p id="captcha-error" class="hidden mt-3 text-sm text-accent-red" role="alert">
              {t.form.captchaMissing}
            </p>
          </div>

          <button
            type="submit"
            class="mt-4 inline-block rounded-[10px] bg-ink px-6 py-3 font-mono text-xs tracking-[0.06em] text-cream uppercase transition-colors duration-200 hover:bg-accent-red-dark disabled:cursor-not-allowed disabled:opacity-60"
          >
            {t.form.submit}
          </button>
        </form>

        <div id="form-success" class="hidden">
          <div class="rounded-[10px] border border-ink p-8 text-center md:p-12">
            <h2 class="mb-4 text-2xl font-medium md:text-3xl">{t.form.successTitle}</h2>
            <p class="text-[17px] leading-[1.55]">
              {t.form.successBody}
            </p>
          </div>
        </div>
      </div>

      <aside class="space-y-8 md:sticky md:top-24 md:self-start">
        <div class="border-l border-ink pl-6">
          <h3 class="text-xl font-medium">{t.aside.directTitle}</h3>
          <p class="mt-3 text-sm leading-relaxed">
            {t.aside.directBody}
          </p>
          <div class="mt-6 space-y-4 text-sm">
            <p>
              <span class="mb-1 block font-mono text-xs tracking-[0.04em] uppercase opacity-60">
                {t.aside.email}
              </span>
              <a href="mailto:info@paulbreuker.nl" class="transition hover:opacity-60">
                info@paulbreuker.nl
              </a>
            </p>
            <p>
              <span class="mb-1 block font-mono text-xs tracking-[0.04em] uppercase opacity-60">
                {t.aside.phone}
              </span>
              <a href="tel:+31651475406" class="transition hover:opacity-60">
                +31 6 51 47 54 06
              </a>
            </p>
            <p>
              <span class="mb-1 block font-mono text-xs tracking-[0.04em] uppercase opacity-60">
                WhatsApp
              </span>
              <a href="https://wa.me/31651475406" class="transition hover:opacity-60">
                +31 6 51 47 54 06
              </a>
            </p>
          </div>
        </div>

        <div class="border-l border-ink pl-6">
          <h3 class="text-xl font-medium">{t.aside.responseTitle}</h3>
          <p class="mt-3 text-sm leading-relaxed">
            {t.aside.responseBody}
          </p>
        </div>

        <div class="border-l border-ink pl-6">
          <h3 class="text-xl font-medium">{t.aside.portraitTitle}</h3>
          <p class="mt-3 text-sm leading-relaxed">
            {t.aside.portraitBefore}
            <a
              href="https://paulbreuker.nl/"
              target="_blank"
              rel="noopener"
              class="underline underline-offset-4 transition hover:opacity-60"
            >
              paulbreuker.nl
            </a>.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successBox = document.getElementById('form-success');
    const errorBox = document.getElementById('form-error');

    const captchaError = document.getElementById('captcha-error');
    const resetCaptcha = () => {
      const hcaptcha = (window as unknown as { hcaptcha?: { reset: () => void } }).hcaptcha;
      hcaptcha?.reset();
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox?.classList.add('hidden');
      captchaError?.classList.add('hidden');

      const formData = new FormData(form);
      if (!String(formData.get('h-captcha-response') ?? '').trim()) {
        captchaError?.classList.remove('hidden');
        return;
      }
      const payload = Object.fromEntries(formData);
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const originalText = submitButton?.textContent ?? '';

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = form.dataset.submitting ?? '...';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(payload),
        });
        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || 'Submission failed');
        }

        form.classList.add('hidden');
        successBox?.classList.remove('hidden');
        successBox?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        errorBox?.classList.remove('hidden');
        resetCaptcha();

        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = originalText;
        }
      }
    });
  </script>

  <script is:inline src="https://web3forms.com/client/script.js" async defer></script>

  <!-- SECTIE 3: KORTE GERUSTSTELLING ONDERAAN -->
  <section class="mx-auto max-w-[1440px] px-6 py-20 md:px-16 md:py-24">
    <div class="mx-auto max-w-3xl border-y border-ink py-12 text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-medium leading-[1.05] uppercase break-words">{t.after.title}</h2>
      <div class="mt-12 grid gap-10 text-left md:grid-cols-3">
        {
          t.after.steps.map((step, index) => (
            <article>
              <span class="grid h-9 w-9 place-items-center rounded-full border border-ink font-mono text-[11px] tracking-[0.06em]">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-2 text-lg font-medium">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed">{step.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
