---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { about } from '../i18n/content/about';
import { ui } from '../i18n/ui';
import { path, type Lang } from '../i18n/routes';
import portret from '../assets/over/portret.jpg';
import foto6 from '../assets/over/foto-6.jpg';
import foto7 from '../assets/over/foto-7.jpg';
import foto8 from '../assets/over/foto-8.png';
import foto9 from '../assets/over/foto-9.png';
import foto10 from '../assets/over/foto-10.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = about[lang];
const cta = ui[lang].cta;
// Engelse periodes ("1997–present") zijn langer dan de Nederlandse.
const periodWidth = lang === 'en' ? 'w-28' : 'w-20';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Paul Breuker',
  jobTitle: t.schema.jobTitle,
  url: 'https://paulbreuker.nl/',
  sameAs: ['https://paulbreuker.nl/'],
  description: t.schema.description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Nijmegen',
    addressCountry: 'NL',
  },
  memberOf: [
    { '@type': 'Organization', name: 'GKF' },
    { '@type': 'Organization', name: 'Dupho' },
  ],
};

const imageClass =
  'h-full w-full rounded-2xl object-cover transition duration-700 hover:scale-105';
---

<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang} page="about">
  <script
    slot="schema"
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />

  <!-- Page header -->
  <section class="pt-24 pb-16 md:pt-32 md:pb-24">
    <div class="mx-auto max-w-[1440px] px-6 md:px-16">
      <p class="font-mono text-xs uppercase tracking-[0.04em] opacity-60">{t.header.eyebrow}</p>
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-medium leading-[1.05]">
        Paul Breuker
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-ink/70 md:text-xl">
        {t.header.intro}
      </p>
    </div>
  </section>

  <!-- Portret en introductie -->
  <section>
    <div class="mx-auto max-w-[1440px] border-t border-ink px-6 py-16 md:px-16 md:py-24">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:items-center md:gap-16">
        <div class="md:col-span-5">
          <Image
            src={portret}
            alt={t.practice.alt}
            class="w-full aspect-[4/5] object-cover object-[65%_50%] rounded-2xl"
            widths={[400, 800]}
            sizes="(max-width: 768px) 100vw, 40vw"
          />
        </div>

        <div class="md:col-span-7 md:pl-8">
          <p class="font-mono text-xs uppercase tracking-[0.04em] opacity-60">
            {t.practice.eyebrow}
          </p>
          <h2 class="mt-8 text-3xl md:text-4xl lg:text-5xl font-medium leading-[1.05] uppercase break-words">
            {t.practice.title}
          </h2>
          <div class="mt-10 space-y-6 text-[17px] leading-relaxed">
            {t.practice.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <p>
              {t.practice.portrait}
              <a
                href={t.practice.portraitLink.href}
                target="_blank"
                rel="noopener"
                class="underline underline-offset-4 transition hover:opacity-60"
              >
                {t.practice.portraitLink.label}
              </a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Werk grid -->
  <section>
    <div class="mx-auto max-w-[1440px] border-t border-ink px-6 py-16 md:px-16 md:py-24">
      <p class="text-center font-mono text-xs uppercase tracking-[0.04em] opacity-60">
        {t.work.eyebrow}
      </p>
      <h2 class="mx-auto mt-6 max-w-3xl text-center text-3xl md:text-4xl lg:text-5xl font-medium leading-[1.05] uppercase break-words">
        {t.work.title}
      </h2>

      <div class="mt-16 grid grid-cols-1 gap-4 md:grid-cols-12 md:gap-6">
        <div class="overflow-hidden rounded-2xl md:col-span-7 md:row-span-2">
          <Image src={foto6} alt={t.work.alts.foto6} class={imageClass} widths={[400, 800, 1200]} sizes="(max-width: 768px) 100vw, 50vw" />
        </div>
        <div class="overflow-hidden rounded-2xl md:col-span-5">
          <Image src={foto7} alt={t.work.alts.foto7} class={imageClass} widths={[400, 800, 1200]} sizes="(max-width: 768px) 100vw, 50vw" />
        </div>
        <div class="overflow-hidden rounded-2xl md:col-span-5">
          <Image src={foto8} alt={t.work.alts.foto8} class={imageClass} widths={[400, 800, 1200]} sizes="(max-width: 768px) 100vw, 50vw" />
        </div>
        <div class="overflow-hidden rounded-2xl md:col-span-5">
          <Image src={foto9} alt={t.work.alts.foto9} class={imageClass} widths={[400, 800, 1200]} sizes="(max-width: 768px) 100vw, 50vw" />
        </div>
        <div class="overflow-hidden rounded-2xl md:col-span-7">
          <Image src={foto10} alt={t.work.alts.foto10} class={imageClass} widths={[400, 800, 1200]} sizes="(max-width: 768px) 100vw, 50vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- Werkwijze -->
  <section>
    <div class="mx-auto max-w-[1440px] border-t border-ink px-6 py-16 md:px-16 md:py-24">
      <p class="font-mono text-xs uppercase tracking-[0.04em] opacity-60">
        {t.approach.eyebrow}
      </p>
      <h2 class="mt-6 max-w-3xl text-3xl md:text-4xl lg:text-5xl font-medium leading-[1.05] uppercase break-words">
        {t.approach.title}
      </h2>

      <div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-12">
        {
          t.approach.items.map((item, index) => (
            <div class="border-t border-ink pt-8">
              <span class="font-mono text-[11px] uppercase tracking-[0.06em] opacity-50">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-6 text-2xl font-medium leading-tight">{item.title}</h3>
              <p class="mt-4 text-[15px] leading-relaxed text-ink/70">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CV hoogtepunten -->
  <section>
    <div class="mx-auto max-w-[1440px] border-t border-ink px-6 py-16 md:px-16 md:py-24">
      <p class="font-mono text-xs uppercase tracking-[0.04em] opacity-60">
        {t.cv.eyebrow}
      </p>
      <h2 class="mt-6 max-w-3xl text-3xl md:text-4xl lg:text-5xl font-medium leading-[1.05] uppercase break-words">
        {t.cv.title}
      </h2>

      <div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-16">
        <div class="md:col-span-4">
          <p class="mb-4 font-mono text-xs uppercase tracking-[0.04em] opacity-50">
            {t.cv.selectionLabel}
          </p>
          <p class="max-w-sm text-[15px] leading-relaxed text-ink/70">
            {t.cv.selectionBody}
          </p>
        </div>

        <div class="md:col-span-8">
          {
            t.cv.groups.map((group) => (
              <div class="border-t border-ink/20 py-8">
                <p class="mb-4 font-mono text-[11px] uppercase tracking-[0.06em] opacity-50">
                  {group.label}
                </p>
                <ul class="space-y-3 text-[17px]">
                  {group.entries.map((entry) => (
                    <li class="flex gap-6">
                      <span class:list={[periodWidth, 'flex-shrink-0 font-mono text-sm tracking-[0.04em] opacity-60']}>
                        {entry.period}
                      </span>
                      <span>{entry.label}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Slot CTA -->
  <section>
    <div class="mx-auto max-w-[1440px] border-t border-ink px-6 py-24 text-center md:px-16 md:py-32">
      <h2 class="mx-auto max-w-2xl text-3xl md:text-4xl lg:text-5xl font-medium leading-[1.05] uppercase break-words">
        {t.closing.title}
      </h2>
      <p class="mx-auto mt-8 max-w-xl text-[17px] leading-relaxed text-ink/70">
        {t.closing.body}
      </p>
      <a
        href={path('contact', lang)}
        class="mt-12 inline-block rounded-[10px] bg-ink px-8 py-4 font-mono text-xs uppercase tracking-[0.06em] text-cream transition-colors duration-200 hover:bg-accent-red-dark"
      >
        {cta}
      </a>
    </div>
  </section>
</BaseLayout>
